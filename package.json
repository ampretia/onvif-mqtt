{
  "name": "@ampretia/onvif-mqtt",
  "version": "1.3.0",
  "description": "Bridges ONVIF events to MQTT topics",
  "keywords": [
    "onvif",
    "mqtt",
    "camera",
    "events"
  ],
  "files": [
    "lib/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "rimraf lib",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
    "build": "npm run clean && tsc --pretty",
    "start": "node --enable-source-maps lib/main.js",
    "release": "commit-and-tag-version",
    "test": "jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ampretia/onvif-mqtt"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.5.2",
    "prettier": "^2.7.1",
    "rimraf": "5.0.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "cosmiconfig": "^10.0.1",
    "mqtt": "^5.16.1",
    "onvif": "0.8.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
